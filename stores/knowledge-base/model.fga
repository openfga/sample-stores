model
  schema 1.1

type user

type organization
  relations
    define member: [user] or admin or editor
    define admin: [user]
    define editor: [user]

type group
  relations
    define organization: [organization]
    define member: [user]

type container
  relations
    define organization: [organization]
    define parent_container: [container]
    define owner: [user]
    define editor: [user, group#member] or owner or admin from organization or editor from parent_container
    define viewer: [user, group#member, user:*] or editor or viewer from parent_container or member from organization
    define can_view: viewer
    define can_edit: editor
    define can_create_article: editor
    define can_delete: owner or admin from organization

type article
  relations
    define organization: [organization]
    define parent_container: [container]
    define parent_article: [article]
    define author: [user]
    define editor: [user, group#member] or author or editor from parent_container
    define viewer: [user, group#member, user:*] or editor or viewer from parent_container
    define can_view: viewer
    define can_edit: editor
    define can_publish: author or admin from organization
    define can_archive: author or admin from organization
    define can_delete: author or admin from organization

type attachment
  relations
    define article: [article]
    define organization: [organization]
    define uploader: [user]
    define can_view: uploader or can_view from article
    define can_delete: uploader or admin from organization
